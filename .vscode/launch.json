{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (smpl_test)",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "CMake: Build (Ninja)",
            "program": "${workspaceFolder}/src/build/smpl_test.exe",
            "args": [
                "--jsonl",
                "C:/Users/Sam/Documents/GaussianAvatar/outputs_sobel/gaussian_train.jsonl",
                "--smpl", "${workspaceFolder}/src/smpl_data.pt", 
                "--epochs", "50",
                "--mesh-method", "poisson",
                "--verbose",
                "--lr", "0.0005",
                "--pose-lr", "0.001",
                "--lr-decay-multiplier", "0.5",
                "--lr-min-multiplier", "0.00001",
                "--lr-decay-epoch", "20",
                "--rot-lr", "0.0001",
                "--offset-lr", "0.0001",
                "--color-lr", "0.001",
                "--opacity-lr", "0.001",
                "--scale-lr", "0.005",
                "--psr-opacity-threshold", "0.05",
                "--psr-samples-per-gaussian", "2",
                "--lambda-dssim", "0.2",
                "--alpha-loss", "1.0",
                "--sh-reg-weight", "0.0005",
                "--output-dir", "C:/Users/Sam/Documents/GaussianAvatar/outputs_sobel/gaussian_renders",
                "--scale-reg", "10.0",
                "--scale-max", "0.01", 
                "--offset-reg", "0.01",
                "--opacity-reg", "0.0",
                "--sugar-reg", "100.0",
                "--densify-every", "200000",
                "--densify-stop-epoch", "30",
                "--densify-max-clones", "100000",
                "--densify-max", "100000",
                "--densify-scale", "0.001", 
                "--densify-min-grad", "0.0002",
                "--densify-reset-opacity", "0", 
                "--densify-prune-opacity", "0.005",
                "--densify-prune-max", "100000",
                "--num-gaussians", "80000",
                "--viewer",
                "--sh-degree", "1"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/src/build",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:/Program Files/NVIDIA/CUDNN/v9.18/bin;C:/opencv/build/x64/vc16/bin;C:/libtorch/lib;${env:PATH}"
                }
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Debug (HMR Inference)",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "CMake: Build (Ninja)",
            "program": "${workspaceFolder}/src/build/hmr_inference.exe", 
            "args": [
                "C:/Users/Sam/Documents/GaussianAvatar/cliff_hr48_static.onnx",
                "C:/Users/Sam/Downloads/Mark.MOV",
                "--output",
                "C:/Users/Sam/Documents/GaussianAvatar/outputs_Mark",
                "--rtmpose",
                "C:/Users/Sam/Documents/GaussianAvatar/rtmpose26.onnx",
                "--rtmpose-cuda",
                "--yolo",
                "C:/Users/Sam/Documents/GaussianAvatar/yolov8n.onnx",
                "--yolo-cuda",
                "--modnet",
                "C:/Users/Sam/Documents/GaussianAvatar/modnet.onnx",
                "--modnet-cuda",
                "--frame-stride", "2",
                "--output-res", "1024"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/src/build",
            "environment": [
                {
                    "name": "PATH", 
                    "value": "C:/Program Files/NVIDIA/CUDNN/v9.18/bin;C:/opencv/build/x64/vc16/bin;C:/libtorch/lib;${env:PATH}"
                }
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Debug (gaussian_viewer)",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "CMake: Build (Ninja)",
            "program": "${workspaceFolder}/src/build/gaussian_viewer.exe",
            "args": [
                "--shm", "GaussianAvatarShared"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/src/build",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:/Program Files/NVIDIA/CUDNN/v9.18/bin;C:/opencv/build/x64/vc16/bin;C:/libtorch/lib;${env:PATH}"
                }
            ],
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "Debug (Train + Viewer)",
            "configurations": [
                "Debug (smpl_test)",
                "Debug (gaussian_viewer)"
            ],
            "stopAll": true
        }
    ]
}
