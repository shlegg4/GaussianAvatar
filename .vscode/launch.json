{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (smpl_test)",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "CMake: Build (Ninja)",
            "program": "${workspaceFolder}/src/build/smpl_test.exe",
            "args": [
                "--jsonl", "${workspaceFolder}/outputs/gaussian_train.jsonl",
                "--smpl", "${workspaceFolder}/src/smpl_data.pt", 
                "--epochs", "500",
                "--lr", "0.0005",
                "--color-lr", "0.01",
                "--opacity-lr", "0.01",
                "--scale-lr", "0.001",
                "--alpha-loss", "50.0",
                "--output-dir", "C:/Users/Sam/Documents/GaussianAvatar/outputs/gaussian_renders",
                "--scale-reg", "0.0001",
                "--scale-max", "0.01", 
                "--offset-reg", "10000.0",
                "--densify-every", "100000",
                "--densify-max-clones", "100000",
                "--densify-max", "100000",
                "--densify-scale", "0.001", 
                "--densify-min-grad", "0.001",
                "--densify-reset-opacity", "0", 
                "--densify-prune-opacity", "0.001",
                "--densify-prune-max", "100000",
                "--num-gaussians", "300000",
                "--viewer",
                "--sh-degree", "1"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/src/build",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:/Program Files/NVIDIA/CUDNN/v9.18/bin;C:/opencv/build/x64/vc16/bin;C:/libtorch/lib;${env:PATH}"

                }
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Debug (HMR Inference)",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "CMake: Build (Ninja)",
            "program": "${workspaceFolder}/src/build/hmr_inference.exe", 
            "args": [
                "C:/Users/Sam/Documents/GaussianAvatar/cliff_hr48_static.onnx", 
                "C:/Users/Sam/Videos/2026-02-03 15-07-55.mp4",
                "--output", "C:/Users/Sam/Documents/GaussianAvatar/outputs/",
                "--rtmpose", "C:/Users/Sam/Documents/GaussianAvatar/rtmpose26.onnx", 
                "--rtmpose-cuda",
                "--yolo", "C:/Users/Sam/Documents/GaussianAvatar/yolov8n.onnx",
                "--yolo-cuda",
                "--modnet", "C:/Users/Sam/Documents/GaussianAvatar/modnet.onnx",
                "--modnet-cuda",
                "--frame-stride", "10",
                "--smplify-requires-yolo"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/src/build",
            "environment": [
                {
                    "name": "PATH", 
                    "value": "C:/Program Files/NVIDIA/CUDNN/v9.18/bin;C:/opencv/build/x64/vc16/bin;C:/libtorch/lib;${env:PATH}"
                }
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Debug (gaussian_viewer)",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "CMake: Build (Ninja)",
            "program": "${workspaceFolder}/src/build/gaussian_viewer.exe",
            "args": [
                "--shm", "GaussianAvatarShared"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/src/build",
            "environment": [
                {
                    "name": "PATH",
                    "value": "D:/cudnn-windows-x86_64-8.9.7.29_cuda12-archive/bin;D:/opencv/build/x64/vc16/bin;D:/libtorch/lib;${env:PATH}"
                }
            ],
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "Debug (Train + Viewer)",
            "configurations": [
                "Debug (smpl_test)",
                "Debug (gaussian_viewer)"
            ],
            "stopAll": true
        }
    ]
}
