{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (smpl_test)",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "CMake: Build (Ninja)",
            "program": "${workspaceFolder}/src_uv/build/smpl_test.exe",
            "args": [
                "--jsonl",
                "C:/Users/Sam/Documents/GaussianAvatar/dataset_outputs/frames.jsonl",
                "--smpl",
                "${workspaceFolder}/smplx_data.pt",
                "--epochs",
                "80",
                "--mesh-method",
                "poisson",
                "--verbose",
                "--lr",
                "0.0005",
                "--pose-lr",
                "0.001",
                "--lr-decay-multiplier",
                "0.75",
                "--lr-min-multiplier",
                "0.01",
                "--lr-decay-epoch",
                "20",
                "--rot-lr",
                "0.0001",
                "--offset-lr",
                "0.00001",
                "--color-lr",
                "0.003",
                "--opacity-lr",
                "0.001",
                "--scale-lr",
                "0.001",
                "--psr-opacity-threshold",
                "0.05",
                "--psr-samples-per-gaussian",
                "2",
                "--lambda-dssim",
                "0.6",
                "--alpha-loss",
                "1.0",
                "--sh-reg-weight",
                "0.0005",
                "--output-dir",
                "C:/Users/Sam/Documents/GaussianAvatar/outputs_sobel/gaussian_renders",
                "--scale-reg",
                "0.0",
                "--scale-max",
                "0.01",
                "--offset-reg",
                "0.0",
                "--opacity-reg",
                "0.1",
                "--sugar-reg",
                "1000.0",
                "--num-gaussians",
                "80000",
                "--viewer",
                "--sh-degree",
                "1"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/src/build",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:/Program Files/NVIDIA/CUDNN/v9.18/bin;C:/opencv/build/x64/vc16/bin;C:/libtorch/lib;${env:PATH}"
                }
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Debug (HMR Inference)",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "CMake: Build (Ninja)",
            "program": "${workspaceFolder}/src/build/hmr_inference.exe",
            "args": [
                "C:/Users/Sam/Documents/GaussianAvatar/cliff_hr48_static.onnx",
                "C:\\Users\\Sam\\Downloads\\Test2.MOV",
                "--output",
                "C:/Users/Sam/Documents/GaussianAvatar/outputs_Mark",
                "--rtmpose",
                "C:/Users/Sam/Documents/GaussianAvatar/rtmpose26.onnx",
                "--rtmpose-cuda",
                "--yolo",
                "C:/Users/Sam/Documents/GaussianAvatar/yolov8n.onnx",
                "--yolo-cuda",
                "--modnet",
                "C:/Users/Sam/Documents/GaussianAvatar/modnet.onnx",
                "--modnet-cuda",
                "--dsine",
                "C:/Users/Sam/Documents/GaussianAvatar/dsine.onnx",
                "--dsine-cuda",
                "--frame-stride",
                "2",
                "--output-res",
                "1024"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/src/build",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:/Program Files/NVIDIA/CUDNN/v9.18/bin;C:/opencv/build/x64/vc16/bin;C:/libtorch/lib;${env:PATH}"
                }
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Debug (gaussian_viewer)",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "CMake: Build (Ninja)",
            "program": "${workspaceFolder}/src_uv/build/gaussian_viewer.exe",
            "args": [
                "--shm",
                "GaussianAvatarShared"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/src_uv/build",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:/Program Files/NVIDIA/CUDNN/v9.18/bin;C:/opencv/build/x64/vc16/bin;C:/libtorch/lib;${env:PATH}"
                }
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Debug (dataset_prep)",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "Build Dataset Prep (Ninja)",
            "program": "${workspaceFolder}/build_dataset_prep/dataset_prep.exe",
            "args": [
                "--output-dir",
                "${workspaceFolder}/dataset_outputs",
                "--target-camera",
                "cam0",
                "--feed",
                "cam0=${workspaceFolder}/data/recording_cam0.mp4",
                "--feed",
                "cam1=${workspaceFolder}/data/recording_cam1.mp4",
                "--feed",
                "cam2=${workspaceFolder}/data/recording_cam2.mp4",
                "--feed",
                "cam3=${workspaceFolder}/data/recording_cam3.mp4",
                "--max-frames",
                "400",
                "--frame-stride",
                "4",
                "--start-frame-index",
                "14",
                "--smooth-alpha",
                "1.0"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build_dataset_prep/",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:/Program Files/NVIDIA/CUDNN/v9.18/bin;C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v12.8/bin;C:/opencv/build/x64/vc16/bin;C:/libtorch/lib;${workspaceFolder}/build_dataset_prep;${env:PATH}"
                }
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Debug (dataset_novel_view_render)",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "Build Dataset Prep (Ninja)",
            "program": "${workspaceFolder}/build_dataset_prep/dataset_novel_view_render.exe",
            "args": [
                "--jsonl",
                "${workspaceFolder}/dataset_outputs/frames.jsonl",
                "--smplx-model",
                "${workspaceFolder}/smplx_data.pt",
                "--output",
                "${workspaceFolder}/dataset_outputs/novel_side_view.mp4",
                "--rtmpose-keypoints-json",
                "${workspaceFolder}/dataset_outputs/rtmpose_keypoints3d.jsonl",
                "--yaw-deg",
                "90",
                "--width",
                "1280",
                "--height",
                "720",
                "--fps",
                "6"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build_dataset_prep/",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:/Program Files/NVIDIA/CUDNN/v9.18/bin;C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v12.8/bin;C:/opencv/build/x64/vc16/bin;C:/libtorch/lib;${workspaceFolder}/build_dataset_prep;${env:PATH}"
                }
            ],
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "Debug (Train + Viewer)",
            "configurations": [
                "Debug (smpl_test)",
                "Debug (gaussian_viewer)"
            ],
            "stopAll": true
        }
    ]
}